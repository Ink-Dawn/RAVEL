# Copy to .env.local and edit machine-local values. Never commit credentials.
RAVEL_ROOT=/path/to/RAVEL
RAVEL_SRC_DIR=/path/to/RAVEL/src
RAVEL_PYTHON=/path/to/router-python
RAVEL_MODEL_PATH=/models/Qwen3-1.7B
RAVEL_SERVED_MODEL_NAME=qwen
RAVEL_ENDPOINTS=a0.example:8000,a1.example:8000,b0.example:8000,b1.example:8000,c0.example:8000
RAVEL_TOPOLOGY=/path/to/RAVEL/configs/topologies/ravel-final-numapinned-v3.2-2-1.json
RAVEL_COLLECTIVE_STAGE_OUTPUT_PROFILE=/path/to/RAVEL/configs/output_profiles/jitserve_collective_stage_context_q95.schema-v2.json
RAVEL_RESULT_ROOT=/path/to/RAVEL/results/local_run
RAVEL_NETWORK_DELAY_MODE=physical
RAVEL_ROUTING_OUTPUT_TOKENS_HINT=256
RAVEL_TTFT_SCALE=1.0
RAVEL_ENGINE_SCHEDULING_POLICY=priority
RAVEL_ENGINE_ADAPTER_MODE=feature_detected
# Export RAVEL_API_KEY or VLLM_API_KEY separately if required. Do not store it here.
