\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces  Mechanism ablation on the 500-request Burst workload at $12\times $ load. FixedPlacement retains RAVEL's initial SLO-aware placement, prospective accounting, and TBT guard but disables pre-handoff reassignment. NoTBTGuard retains global RAVEL routing and replanning but disables the engine-local TBT guard. The panels report (a) request-level SLO attainment, (b) P95 TTFT, (c) the TBT-violation rate among LATENCY requests, and (d) P95 E2E. Higher is better only for SLO attainment. }}{12}{figure.5}\protected@file@percent }
\newlabel{fig:mechanism-breakdown}{{5}{12}{Mechanism ablation on the 500-request Burst workload at $12\times $ load. FixedPlacement retains RAVEL's initial SLO-aware placement, prospective accounting, and TBT guard but disables pre-handoff reassignment. NoTBTGuard retains global RAVEL routing and replanning but disables the engine-local TBT guard. The panels report (a) request-level SLO attainment, (b) P95 TTFT, (c) the TBT-violation rate among LATENCY requests, and (d) P95 E2E. Higher is better only for SLO attainment}{figure.5}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces  \textbf  {Quote accuracy in the workload-$16\times $ analysis.} Panel (a) shows the empirical CDF of normalized quote error $(\widehat  {L}_i-L_i)/B_i$ for LATENCY (TTFT) and completion (E2E) requests. The shaded band denotes errors within $\pm 10\%$ of the applicable SLO budget. Panel (b) reports feasibility-classification error rates over the same $N=2{,}500$ selected final-handoff records. Among 1,672 quoted-feasible decisions, 104 are false feasible (6.2\%); among 828 quoted-infeasible decisions, 8 are false infeasible (1.0\%). }}{12}{figure.6}\protected@file@percent }
\newlabel{fig:quote-accuracy}{{6}{12}{\textbf {Quote accuracy in the workload-$16\times $ analysis.} Panel (a) shows the empirical CDF of normalized quote error $(\widehat {L}_i-L_i)/B_i$ for LATENCY (TTFT) and completion (E2E) requests. The shaded band denotes errors within $\pm 10\%$ of the applicable SLO budget. Panel (b) reports feasibility-classification error rates over the same $N=2{,}500$ selected final-handoff records. Among 1,672 quoted-feasible decisions, 104 are false feasible (6.2\%); among 828 quoted-infeasible decisions, 8 are false infeasible (1.0\%)}{figure.6}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces  \textbf  {Planner overhead on the five-replica testbed.} Panel (a) reports median planner latency as the candidate cohort bound $K$ increases on a $\log _2$ scale. The shaded bands span P5--P95 over 50 measured repetitions per point after five warm-up repetitions; the dashed line marks the configured online bound $K=64$, while $K=128$ is a stress-only point. Panel (b) shows the empirical CDF of scheduling-pass latency for 281 actual passes from Burst at $12\times $ load. }}{12}{figure.7}\protected@file@percent }
\newlabel{fig:planner-overhead}{{7}{12}{\textbf {Planner overhead on the five-replica testbed.} Panel (a) reports median planner latency as the candidate cohort bound $K$ increases on a $\log _2$ scale. The shaded bands span P5--P95 over 50 measured repetitions per point after five warm-up repetitions; the dashed line marks the configured online bound $K=64$, while $K=128$ is a stress-only point. Panel (b) shows the empirical CDF of scheduling-pass latency for 281 actual passes from Burst at $12\times $ load}{figure.7}{}}
