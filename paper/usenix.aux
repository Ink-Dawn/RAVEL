\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces  \textbf  {RAVEL request lifecycle and ownership boundary.} RAVEL combines each request's prompt and SLO with calibrated service profiles and live replica state to construct request-specific replica quotes. It then creates a virtual placement and immediately attributes the request's prospective demand to its tentative replica. While the request remains Router-owned, subsequent arrivals may trigger bounded reassignment together with an atomic transfer of its prospective accounting. Capacity-gated dispatch initiates engine handoff; only a successful handoff makes placement final. Pending, running, and completed engine state continuously feeds back into later quotes and accounting updates. }}{5}{figure.2}\protected@file@percent }
\newlabel{fig:ravel-overview}{{2}{5}{\textbf {RAVEL request lifecycle and ownership boundary.} RAVEL combines each request's prompt and SLO with calibrated service profiles and live replica state to construct request-specific replica quotes. It then creates a virtual placement and immediately attributes the request's prospective demand to its tentative replica. While the request remains Router-owned, subsequent arrivals may trigger bounded reassignment together with an atomic transfer of its prospective accounting. Capacity-gated dispatch initiates engine handoff; only a successful handoff makes placement final. Pending, running, and completed engine state continuously feeds back into later quotes and accounting updates}{figure.2}{}}
\newlabel{eq:ravel-completion-feasible}{{5}{5}{Replica SLO Quotes}{equation.5}{}}
