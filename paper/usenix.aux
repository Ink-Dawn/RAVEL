\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces  End-to-end results for LMSYS (top), Burst (middle), and DeepResearch (bottom), using one 500-request replay per policy--workload--load cell. The first column reports request-level SLO attainment as offered load increases from $1\times $ to $16\times $; the remaining columns report per-request TTFT, E2E, and TPOT distributions at $1\times $. In each box plot, the red line marks the median, the box spans the 25th--75th percentiles, the whiskers show the 10th--90th percentiles, and the inverted triangle marks the mean. RAVEL maintains the highest SLO attainment as contention grows and outperforms the best baseline on all three workloads. }}{10}{figure.3}\protected@file@percent }
\newlabel{fig:main-results}{{3}{10}{End-to-end results for LMSYS (top), Burst (middle), and DeepResearch (bottom), using one 500-request replay per policy--workload--load cell. The first column reports request-level SLO attainment as offered load increases from $1\times $ to $16\times $; the remaining columns report per-request TTFT, E2E, and TPOT distributions at $1\times $. In each box plot, the red line marks the median, the box spans the 25th--75th percentiles, the whiskers show the 10th--90th percentiles, and the inverted triangle marks the mean. RAVEL maintains the highest SLO attainment as contention grows and outperforms the best baseline on all three workloads}{figure.3}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {5.3}Repeated-Run Robustness}{10}{subsection.5.3}\protected@file@percent }
\newlabel{sec:eval:robustness}{{5.3}{10}{Repeated-Run Robustness}{subsection.5.3}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces  \textbf  {Repeated-run robustness at $16\times $ load.} Each small circle reports the paired RAVEL--baseline difference in request-level SLO attainment for one complete 500-request replay. The large diamond marks the mean over five paired runs, and the horizontal whisker shows the corresponding 95\% confidence interval computed from the five run-level differences. The plotted comparison uses the designated best baseline for the corresponding workload. Mean gains are 4.1, 7.5, and 17.4 percentage points for LMSYS, Burst, and DeepResearch, respectively. }}{11}{figure.4}\protected@file@percent }
\newlabel{fig:repeated-runs}{{4}{11}{\textbf {Repeated-run robustness at $16\times $ load.} Each small circle reports the paired RAVEL--baseline difference in request-level SLO attainment for one complete 500-request replay. The large diamond marks the mean over five paired runs, and the horizontal whisker shows the corresponding 95\% confidence interval computed from the five run-level differences. The plotted comparison uses the designated best baseline for the corresponding workload. Mean gains are 4.1, 7.5, and 17.4 percentage points for LMSYS, Burst, and DeepResearch, respectively}{figure.4}{}}
